FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ARG VIPS_VERSION=8.18.5

# 1. Force APT to use IPv4 & switch mirror for fast downloads
RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 && \
    sed -i 's|http://archive.ubuntu.com/ubuntu/|http://mirrors.edge.kernel.org/ubuntu/|g' /etc/apt/sources.list.d/ubuntu.sources

# 2. Install build tools, benchmark binaries, and libvips delegate dependencies in ONE layer
RUN apt-get update && \
    apt-get install -y software-properties-common && \
    add-apt-repository -y ppa:ubuntuhandbook1/libheif && \
    apt-get update && \
    apt-get install -y \
    build-essential \
    meson \
    ninja-build \
    pkg-config \
    wget \
    hyperfine \
    python3 \
    python3-pip \
    graphicsmagick \
    imagemagick \
    libglib2.0-dev \
    libexpat1-dev \
    libjpeg-turbo8-dev \
    libpng-dev \
    libspng-dev \
    libwebp-dev \
    libheif-dev \
    liblcms2-dev \
    libheif-plugin-libde265 \
    libheif1 \
    libbz2-dev \
    libexif-dev \
    libdeflate-dev && \
    apt-get purge -y ghostscript && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 3. Install pyvips Python module (required for pyvips benchmark step)
RUN pip3 install pyvips --break-system-packages

# 4. Download and compile libvips from source
WORKDIR /tmp
RUN wget https://github.com/libvips/libvips/releases/download/v${VIPS_VERSION}/vips-${VIPS_VERSION}.tar.xz && \
    tar xf vips-${VIPS_VERSION}.tar.xz && \
    cd vips-${VIPS_VERSION} && \
    meson setup build --buildtype=release -Dintrospection=disabled && \
    ninja -C build && \
    ninja -C build install && \
    ldconfig && \
    cd /tmp && rm -rf vips-*

WORKDIR /benchmarks
COPY benchmark_resize.sh .
COPY conf/ ./conf/

CMD ["/bin/bash"]